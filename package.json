{
  "name": "portfolio",
  "private": true,
  "packageManager": "bun@1.3.11",
  "scripts": {
    "predev": "cd ../TroisiUI && bun run build",
    "postinstall": "cd ../TroisiUI && test -f dist/styles/troisi-ui.css || bun run build",
